<Window x:Class="PasteSheet.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:PasteSheet.Presentation"
        Title="PasteSheet"
        WindowStyle="None" AllowsTransparency="False" Background="#121212"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        ShowActivated="True" SnapsToDevicePixels="True"
        KeyboardNavigation.TabNavigation="None"
        KeyboardNavigation.ControlTabNavigation="None"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <p:BoolToVisibilityConverter x:Key="BoolVis" />
        <p:BoolToVisibilityConverter x:Key="BoolVisInvert" Invert="True" />
        <p:ViewTypeVisibilityConverter x:Key="SettingsVis" />
        <p:ViewTypeVisibilityConverter x:Key="NotSettingsVis" Invert="True" />
        <p:StringEmptyToVisibilityConverter x:Key="EmptyVis" />
        <p:StringEmptyToVisibilityConverter x:Key="NotEmptyVis" Invert="True" />
        <p:ActionButtonBrushConverter x:Key="BtnBg" Background="True" />
        <p:ActionButtonBrushConverter x:Key="BtnFg" Background="False" />
        <p:ActionButtonBrushConverter x:Key="BtnBorder" Border="True" />
        <p:TimeoutSegmentConverter x:Key="SegBg" Background="True" />
        <p:TimeoutSegmentConverter x:Key="SegFg" Background="False" />
        <p:TimeoutSegmentConverter x:Key="SegWt" Weight="True" />
        <p:SearchItemsHeaderConverter x:Key="ItemsHeader" />
        <p:ConfirmButtonBrushConverter x:Key="ConfirmBg" Background="True" />
        <p:ConfirmButtonBrushConverter x:Key="ConfirmFg" Background="False" />

        <SolidColorBrush x:Key="Bg" Color="#121212" />
        <SolidColorBrush x:Key="Panel" Color="#1A1A1A" />
        <!-- Redesign tokens (calm gold palette, macOS 0.6.0 parity) -->
        <SolidColorBrush x:Key="Accent" Color="#C7CA46" />
        <SolidColorBrush x:Key="FocusBorder" Color="#B9BC44" />
        <SolidColorBrush x:Key="TextPrimary" Color="#EDEDE8" />
        <SolidColorBrush x:Key="TextSecondary" Color="#9A9A92" />
        <SolidColorBrush x:Key="TextTertiary" Color="#7C7C74" />
        <SolidColorBrush x:Key="Surface" Color="#232320" />
        <SolidColorBrush x:Key="PanelBg" Color="#1B1B19" />
        <SolidColorBrush x:Key="NeutralBorder" Color="#1AFFFFFF" />
        <SolidColorBrush x:Key="Divider" Color="#0FFFFFFF" />
        <SolidColorBrush x:Key="DangerText" Color="#D85A30" />
        <SolidColorBrush x:Key="MatchChip" Color="#2EC7CA46" />
        <!-- Legacy aliases re-pointed onto the new palette -->
        <SolidColorBrush x:Key="SubText" Color="#9A9A92" />
        <SolidColorBrush x:Key="SubText40" Color="#1AFFFFFF" />
        <SolidColorBrush x:Key="Memo" Color="#EDEDE8" />
        <SolidColorBrush x:Key="Danger" Color="#E24B4A" />
        <SolidColorBrush x:Key="Fg" Color="#EDEDE8" />
        <SolidColorBrush x:Key="White10" Color="#1AFFFFFF" />
        <SolidColorBrush x:Key="White08" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="Content70" Color="#9A9A92" />

        <!-- Borderless flat icon button -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1AFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Inline action button (Paste / Edit / Delete) -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource White10}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="14,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Switch-style toggle (mac-like), tinted accent when on -->
        <Style x:Key="SwitchToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="track" Width="42" Height="24" CornerRadius="12">
                            <Border.Background>
                                <SolidColorBrush Color="#33FFFFFF" />
                            </Border.Background>
                            <Border x:Name="thumb" Width="18" Height="18" CornerRadius="9"
                                    HorizontalAlignment="Left" Margin="3,0,0,0"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.Background>
                                    <SolidColorBrush Color="#FFFFFFFF" />
                                </Border.Background>
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="thumbT" X="0" />
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="thumbT" Storyboard.TargetProperty="X"
                                                             To="18" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <ColorAnimation Storyboard.TargetName="track" Storyboard.TargetProperty="Background.Color"
                                                            To="#C7CA46" Duration="0:0:0.18" />
                                            <ColorAnimation Storyboard.TargetName="thumb" Storyboard.TargetProperty="Background.Color"
                                                            To="#121212" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="thumbT" Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <ColorAnimation Storyboard.TargetName="track" Storyboard.TargetProperty="Background.Color"
                                                            To="#33FFFFFF" Duration="0:0:0.18" />
                                            <ColorAnimation Storyboard.TargetName="thumb" Storyboard.TargetProperty="Background.Color"
                                                            To="#FFFFFFFF" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Settings group header -->
        <Style x:Key="GroupHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextTertiary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="4,0,0,12" />
        </Style>

        <!-- Settings card -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource NeutralBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!-- Modal/detail card entrance: scale 0.95→1 + opacity 0→1, 0.2s easeInOut (macOS parity) -->
        <Style x:Key="ModalCardAnim" TargetType="Border">
            <Style.Triggers>
                <Trigger Property="IsVisible" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseInOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 From="0.95" To="1" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseInOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="0.95" To="1" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseInOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Settings segmented timeout button -->
        <Style x:Key="SegButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="10,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Default flat button (no system chrome). Explicitly-styled buttons
             (IconButton/ActionButton/SegButton) override this. -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Inline edit form, realized only for the row being edited (DataContext = AppViewModel).
             Content field first, then memo; right-aligned [Cancel][Save]. -->
        <DataTemplate x:Key="InlineEditTemplate">
            <StackPanel>
                <TextBlock Text="CONTENT" FontSize="11" Foreground="{StaticResource TextTertiary}" Margin="2,0,0,4" />
                <Border Background="{StaticResource Surface}" CornerRadius="8" Padding="8"
                        BorderBrush="{StaticResource NeutralBorder}" BorderThickness="1">
                    <TextBox Background="Transparent" BorderThickness="0" Loaded="OnEditBoxLoaded"
                             Foreground="{StaticResource TextPrimary}" CaretBrush="{StaticResource Accent}" FontSize="14" MinHeight="120"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Text="{Binding EditContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Border>
                <TextBlock Text="MEMO · optional" FontSize="11" Foreground="{StaticResource TextTertiary}" Margin="2,8,0,4" />
                <Border Background="{StaticResource Surface}" CornerRadius="8" Padding="8"
                        BorderBrush="{StaticResource NeutralBorder}" BorderThickness="1">
                    <Grid>
                        <TextBox x:Name="EditMemoBox" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextPrimary}" CaretBrush="{StaticResource Accent}" FontSize="13" FontWeight="Medium"
                                 Text="{Binding EditMemo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Add a note…" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextTertiary}"
                                   IsHitTestVisible="False" VerticalAlignment="Center"
                                   Visibility="{Binding Text, ElementName=EditMemoBox, Converter={StaticResource EmptyVis}}" />
                    </Grid>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="Cancel" Style="{StaticResource ActionButton}" Margin="0,0,8,0"
                            Click="OnInlineCancel" Background="Transparent" Foreground="{StaticResource TextSecondary}" />
                    <Button Content="Save  Ctrl+↵" Style="{StaticResource ActionButton}"
                            Click="OnInlineSave" Background="{StaticResource Accent}" Foreground="{StaticResource PanelBg}" BorderThickness="0" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- ===== Thin overlay scrollbars (PS-69). macOS-style: 6px wide, no
             arrow buttons, transparent track, translucent white thumb that
             brightens on hover. The ScrollViewer template stacks the bars on
             top of the content (single grid cell) so they take no layout
             width, like the macOS overlay scrollers. Implicit styles below
             restyle every ScrollViewer/ScrollBar in the window, including the
             ones inside ListBox and TextBox templates (list, settings, detail
             modal, inline edit box). ===== -->

        <!-- Invisible page-up/down track buttons (replace the arrow chrome) -->
        <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded translucent thumb -->
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="tb" Background="#40FFFFFF" CornerRadius="3" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tb" Property="Background" Value="#66FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="tb" Property="Background" Value="#66FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="ThinVerticalScrollBar" TargetType="ScrollBar">
            <Grid Background="Transparent">
                <Track x:Name="PART_Track" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageUpCommand" />
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageDownCommand" />
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource ScrollThumb}" />
                    </Track.Thumb>
                </Track>
            </Grid>
        </ControlTemplate>

        <ControlTemplate x:Key="ThinHorizontalScrollBar" TargetType="ScrollBar">
            <Grid Background="Transparent">
                <Track x:Name="PART_Track">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageLeftCommand" />
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageRightCommand" />
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource ScrollThumb}" />
                    </Track.Thumb>
                </Track>
            </Grid>
        </ControlTemplate>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="6" />
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="Template" Value="{StaticResource ThinVerticalScrollBar}" />
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Height" Value="6" />
                    <Setter Property="MinHeight" Value="6" />
                    <Setter Property="Template" Value="{StaticResource ThinHorizontalScrollBar}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Overlay ScrollViewer: content fills the whole area, scrollbars
             float above it instead of occupying a layout column/row. -->
        <Style TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid Background="{TemplateBinding Background}">
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    Margin="{TemplateBinding Padding}"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}" />
                            <ScrollBar x:Name="PART_VerticalScrollBar" Orientation="Vertical"
                                       HorizontalAlignment="Right" Margin="0,2,2,2" Cursor="Arrow"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                            <ScrollBar x:Name="PART_HorizontalScrollBar" Orientation="Horizontal"
                                       VerticalAlignment="Bottom" Margin="2,0,2,2" Cursor="Arrow"
                                       Value="{TemplateBinding HorizontalOffset}"
                                       Maximum="{TemplateBinding ScrollableWidth}"
                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- List row container: stretch, no default selection chrome -->
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer rounded window -->
    <Border Background="{StaticResource Bg}" CornerRadius="12"
            BorderBrush="#1AFFFFFF" BorderThickness="1">
        <Grid>
            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="16,16,16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Back button -->
                    <Button Grid.Column="0" Content="&#x25C0;" FontFamily="Segoe UI Symbol" FontSize="16" Margin="0,0,8,0"
                            Foreground="{StaticResource TextSecondary}" Style="{StaticResource IconButton}"
                            Click="OnBackClick"
                            Visibility="{Binding ShowBack, Converter={StaticResource BoolVis}}" />

                    <!-- Title / search overlay -->
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextPrimary}" CaretBrush="{StaticResource Accent}"
                                 FontWeight="Medium" Padding="0"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <!-- Header font matches mac HeaderView: 17 when back button shown, 20 otherwise -->
                                <Style TargetType="TextBox">
                                    <Setter Property="FontSize" Value="20" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowBack}" Value="True">
                                            <Setter Property="FontSize" Value="17" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <!-- Title shown when no query; click passes through to the textbox -->
                        <StackPanel Orientation="Horizontal" IsHitTestVisible="False"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding SearchQuery, Converter={StaticResource EmptyVis}}">
                            <TextBlock Text="{Binding HeaderTitle}" Foreground="{StaticResource TextPrimary}"
                                       FontWeight="Medium" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <!-- Header font matches mac HeaderView: 17 when back button shown, 20 otherwise -->
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="20" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowBack}" Value="True">
                                                <Setter Property="FontSize" Value="17" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <!-- Settings gear -->
                    <Button Grid.Column="2" Content="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                            Foreground="{StaticResource TextTertiary}" Style="{StaticResource IconButton}"
                            Click="OnSettingsClick"
                            Visibility="{Binding CurrentView, Converter={StaticResource NotSettingsVis}, ConverterParameter=Settings}" />
                </Grid>

                <!-- 1px divider between header and content (PS-58), matching mac
                     ContentView's Divider().opacity(0.1). -->
                <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom"
                        Background="{StaticResource White10}" />

                <!-- List + search summary / footers -->
                <DockPanel Grid.Row="1"
                           Visibility="{Binding CurrentView, Converter={StaticResource NotSettingsVis}, ConverterParameter=Settings}">

                    <!-- Search result count summary (top) -->
                    <TextBlock DockPanel.Dock="Top" Text="{Binding ResultSummary}" Margin="14,4,14,2"
                               FontSize="13" Foreground="{StaticResource TextSecondary}"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding IsSearching, Converter={StaticResource BoolVis}}" />

                    <!-- Section header "ITEMS (N)" above the search results (PS-7). Hidden
                         when not searching or when no items matched. -->
                    <TextBlock DockPanel.Dock="Top" Margin="14,6,14,2"
                               FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextTertiary}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource ItemsHeader}">
                                <Binding Path="Rows" />
                                <Binding Path="ResultSummary" />
                            </MultiBinding>
                        </TextBlock.Text>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Bottom footers: hint (item list) / folder count (root) -->
                    <TextBlock DockPanel.Dock="Bottom" Text="&#x21B5; paste · Ctrl+N new · Del delete"
                               Margin="14,8,14,8" FontSize="11" Foreground="{StaticResource TextTertiary}"
                               HorizontalAlignment="Center"
                               Visibility="{Binding ShowItemHint, Converter={StaticResource BoolVis}}" />
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding FolderFooter}"
                               Margin="14,8,14,8" FontSize="11" Foreground="{StaticResource TextTertiary}"
                               HorizontalAlignment="Center"
                               Visibility="{Binding FolderFooter, Converter={StaticResource NotEmptyVis}}" />

                    <!-- Fill area: the list, with the "No matches" empty state overlaid. -->
                    <Grid>
                    <StackPanel VerticalAlignment="Top" Margin="0,60,0,0" HorizontalAlignment="Center"
                                Visibility="{Binding HasNoResults, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="28"
                                   Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Center" />
                        <TextBlock Text="No matches" FontSize="15" Foreground="{StaticResource TextSecondary}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                        <!-- PS-62: mac SearchResultView subtitle -->
                        <TextBlock FontSize="13" Foreground="{StaticResource TextTertiary}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"
                                   Text="{Binding SearchQuery, StringFormat='Nothing found for \&quot;{0}\&quot;'}" />
                    </StackPanel>

                    <!-- PS-26: empty-folder notice (mac ItemListView "No items found in this
                         folder", 14pt white 40%, 40 below the New item row). Hidden while
                         searching or while the inline creation form is open. -->
                    <TextBlock Text="No items found in this folder" FontSize="14" Foreground="#66FFFFFF"
                               HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,92,0,0"
                               IsHitTestVisible="False"
                               Visibility="{Binding HasNoItems, Converter={StaticResource BoolVis}}" />

                <ListBox x:Name="List" Margin="6,0"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ItemsSource="{Binding Rows}"
                         SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                         MouseDoubleClick="OnListDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="12" Padding="0">
                                <!-- Own SolidColorBrush instance (transparent Surface) so the
                                     selection tint can fade via ColorAnimation (PS-10). -->
                                <Border.Background>
                                    <SolidColorBrush Color="#00232320" />
                                </Border.Background>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                                                            To="#232320" Duration="0:0:0.12">
                                                                <ColorAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseInOut" />
                                                                </ColorAnimation.EasingFunction>
                                                            </ColorAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                                                            To="#00232320" Duration="0:0:0.12">
                                                                <ColorAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseInOut" />
                                                                </ColorAnimation.EasingFunction>
                                                            </ColorAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <!-- ============ Directory row ============ -->
                                    <Grid Margin="12" Background="Transparent"
                                          Visibility="{Binding IsDirectory, Converter={StaticResource BoolVis}}"
                                          ContextMenuOpening="OnDirectoryContextMenuOpening">
                                        <Grid.ContextMenu>
                                            <!-- PS-28/PS-39: folder Rename/Delete (mac DirectoryListView context menu) -->
                                            <ContextMenu>
                                                <MenuItem Header="Rename" Click="OnDirRename" />
                                                <MenuItem Header="Delete" Click="OnDirDelete" />
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="3" CornerRadius="1.5" Margin="0,0,10,0"
                                                VerticalAlignment="Stretch">
                                            <Border.Background>
                                                <SolidColorBrush Color="#1AFFFFFF" />
                                            </Border.Background>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                                                                        To="#C7CA46" Duration="0:0:0.12">
                                                                            <ColorAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseInOut" />
                                                                            </ColorAnimation.EasingFunction>
                                                                        </ColorAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                                                                        To="#1AFFFFFF" Duration="0:0:0.12">
                                                                            <ColorAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseInOut" />
                                                                            </ColorAnimation.EasingFunction>
                                                                        </ColorAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <!-- PS-24: folder glyph, mirroring mac DirectoryRow's Image(systemName: "folder") -->
                                        <TextBlock Grid.Column="1" Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="14" Width="20" Margin="0,0,10,0" TextAlignment="Center"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextTertiary}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" Text="{Binding DirectoryName}" FontSize="15"
                                                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{Binding CountText}" FontSize="12" FontWeight="Medium"
                                                   Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- ============ New folder / item row ============ -->
                                    <Grid Visibility="{Binding IsNew, Converter={StaticResource BoolVis}}">
                                        <!-- Dashed rounded border (neutral, dash 5) -->
                                        <Rectangle RadiusX="8" RadiusY="8" Stroke="{StaticResource NeutralBorder}" StrokeThickness="1"
                                                   StrokeDashArray="5 5" SnapsToDevicePixels="True" />

                                        <!-- Idle: + label, click to expand -->
                                        <StackPanel Orientation="Horizontal" Margin="12" Background="Transparent"
                                                    MouseLeftButtonUp="OnNewRowClick"
                                                    Visibility="{Binding DataContext.IsCreatingNew, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisInvert}}">
                                            <TextBlock Text="＋" FontSize="18" FontWeight="Bold"
                                                       Foreground="{StaticResource TextTertiary}" Margin="0,0,12,0" />
                                            <TextBlock Text="{Binding NewLabel}" FontSize="14"
                                                       Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <!-- Active: inline creation form -->
                                        <StackPanel Margin="12"
                                                    Visibility="{Binding DataContext.IsCreatingNew, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}">
                                            <!-- Folder: name field. mac DirectoryListView wraps the active field in a
                                                 surface box with a focusBorder ring while it is shown (PS-25); on mac the
                                                 field only exists while focused, so the ring is unconditional. -->
                                            <Border Background="{StaticResource Surface}" CornerRadius="8" Padding="8"
                                                    BorderBrush="{StaticResource FocusBorder}" BorderThickness="1"
                                                    Visibility="{Binding IsNewFolder, Converter={StaticResource BoolVis}}">
                                                <Grid>
                                                    <TextBox x:Name="NewFolderBox" FontSize="14" Foreground="{StaticResource TextPrimary}" CaretBrush="{StaticResource Accent}"
                                                             Background="Transparent" BorderThickness="0"
                                                             IsVisibleChanged="OnNewInputShown"
                                                             Text="{Binding DataContext.NewInputContent, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Text="Folder Name…" FontSize="14" Foreground="{StaticResource TextTertiary}"
                                                               IsHitTestVisible="False" VerticalAlignment="Center"
                                                               Visibility="{Binding Text, ElementName=NewFolderBox, Converter={StaticResource EmptyVis}}" />
                                                </Grid>
                                            </Border>
                                            <!-- Item: content field first, then memo -->
                                            <StackPanel Visibility="{Binding IsNewItem, Converter={StaticResource BoolVis}}">
                                                <TextBlock Text="CONTENT" FontSize="11" Foreground="{StaticResource TextTertiary}" Margin="2,0,0,4" />
                                                <!-- 0.5 hairline border to match mac (PS-59). -->
                                                <Border Background="{StaticResource Surface}" CornerRadius="8" Padding="8"
                                                        UseLayoutRounding="False" SnapsToDevicePixels="False"
                                                        BorderBrush="{StaticResource NeutralBorder}" BorderThickness="0.5">
                                                    <Grid>
                                                        <TextBox x:Name="NewItemContentBox" Background="Transparent" BorderThickness="0"
                                                                 Foreground="{StaticResource TextPrimary}" CaretBrush="{StaticResource Accent}" FontSize="14" MinHeight="80"
                                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                                 VerticalScrollBarVisibility="Auto"
                                                                 IsVisibleChanged="OnNewInputShown"
                                                                 Text="{Binding DataContext.NewInputContent, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        <TextBlock Text="Content…" FontSize="14" Foreground="{StaticResource TextTertiary}"
                                                                   IsHitTestVisible="False" VerticalAlignment="Top"
                                                                   Visibility="{Binding Text, ElementName=NewItemContentBox, Converter={StaticResource EmptyVis}}" />
                                                    </Grid>
                                                </Border>
                                                <TextBlock Text="MEMO · optional" FontSize="11" Foreground="{StaticResource TextTertiary}" Margin="2,8,0,4" />
                                                <!-- 0.5 hairline border to match mac (PS-59). -->
                                                <Border Background="{StaticResource Surface}" CornerRadius="8" Padding="8"
                                                        UseLayoutRounding="False" SnapsToDevicePixels="False"
                                                        BorderBrush="{StaticResource NeutralBorder}" BorderThickness="0.5">
                                                    <Grid>
                                                        <TextBox x:Name="NewItemMemoBox" Background="Transparent" BorderThickness="0"
                                                                 Foreground="{StaticResource TextPrimary}" CaretBrush="{StaticResource Accent}" FontSize="13" FontWeight="Medium"
                                                                 Text="{Binding DataContext.NewInputMemo, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        <TextBlock Text="Add a note…" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextTertiary}"
                                                                   IsHitTestVisible="False" VerticalAlignment="Center"
                                                                   Visibility="{Binding Text, ElementName=NewItemMemoBox, Converter={StaticResource EmptyVis}}" />
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                                <Button Content="Cancel" Style="{StaticResource ActionButton}" Margin="0,0,8,0"
                                                        Click="OnNewCancel"
                                                        Background="Transparent" Foreground="{StaticResource TextSecondary}" />
                                                <Button Content="Save" Style="{StaticResource ActionButton}"
                                                        Click="OnNewSave"
                                                        Background="{StaticResource Accent}" Foreground="{StaticResource PanelBg}" BorderThickness="0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <!-- ============ Item row ============ -->
                                    <Grid Margin="14,11" Visibility="{Binding IsItem, Converter={StaticResource BoolVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Accent bar (PS-48: always full height like mac SelectionBar) -->
                                        <Border Grid.Column="0" Width="3" CornerRadius="1.5" Margin="0,0,12,0"
                                                VerticalAlignment="Stretch">
                                            <Border.Background>
                                                <SolidColorBrush Color="#1AFFFFFF" />
                                            </Border.Background>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                                                                        To="#C7CA46" Duration="0:0:0.12">
                                                                            <ColorAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseInOut" />
                                                                            </ColorAnimation.EasingFunction>
                                                                        </ColorAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                                                                        To="#1AFFFFFF" Duration="0:0:0.12">
                                                                            <ColorAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseInOut" />
                                                                            </ColorAnimation.EasingFunction>
                                                                        </ColorAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <StackPanel Grid.Column="1"
                                                    Visibility="{Binding IsEditing, Converter={StaticResource BoolVisInvert}}">
                                            <!-- Memo + folder label -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" FontSize="13" FontWeight="Medium"
                                                           TextTrimming="CharacterEllipsis"
                                                           p:Highlight.Query="{Binding DataContext.SearchQuery, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           p:Highlight.SourceText="{Binding Memo}"
                                                           p:Highlight.BaseForeground="{StaticResource TextPrimary}"
                                                           Visibility="{Binding HasMemo, Converter={StaticResource BoolVis}}" />
                                                <!-- 0.5 hairline border to match mac (PS-59). -->
                                                <Border Grid.Column="1" Background="{StaticResource Surface}" CornerRadius="4"
                                                        Padding="7,2" VerticalAlignment="Center"
                                                        UseLayoutRounding="False" SnapsToDevicePixels="False"
                                                        BorderBrush="{StaticResource NeutralBorder}" BorderThickness="0.5"
                                                        Visibility="{Binding ShowFolderLabel, Converter={StaticResource BoolVis}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="5" Height="5" Fill="{StaticResource TextSecondary}"
                                                                 VerticalAlignment="Center" Margin="0,0,4,0" />
                                                        <TextBlock Text="{Binding FolderLabel}" FontSize="10"
                                                                   Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <!-- Content. Rendered via the Highlight attached property so search
                                                 matches get a gold chip (PS-6); Text/Foreground are driven through
                                                 Highlight.SourceText/BaseForeground so the selection swap still works. -->
                                            <TextBlock FontSize="14" Margin="0,2,0,0"
                                                       p:Highlight.Query="{Binding DataContext.SearchQuery, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="p:Highlight.SourceText" Value="{Binding ContentOneLine}" />
                                                        <Setter Property="p:Highlight.BaseForeground" Value="{StaticResource TextSecondary}" />
                                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                        <Setter Property="TextWrapping" Value="NoWrap" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                <Setter Property="p:Highlight.BaseForeground" Value="{StaticResource TextPrimary}" />
                                                                <Setter Property="TextTrimming" Value="None" />
                                                                <Setter Property="TextWrapping" Value="Wrap" />
                                                                <Setter Property="MaxHeight" Value="300" />
                                                                <Setter Property="p:Highlight.SourceText" Value="{Binding ContentPreview}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- Date + actions (selected only) -->
                                            <StackPanel Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BoolVis}}">
                                                <TextBlock Text="{Binding DateDisplay}" FontSize="11"
                                                           Foreground="{StaticResource TextTertiary}" Margin="0,8,0,0" />
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Gold-primary Paste: always gold fill + dark text (macOS parity);
                                                         keyboard focus shows as a focusBorder ring instead of a fill change. -->
                                                    <Button Grid.Column="0" Content="Paste" Style="{StaticResource ActionButton}" Margin="0,0,8,0"
                                                            Click="OnRowPaste"
                                                            Background="{Binding DataContext.ButtonFocusIndex, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BtnBg}, ConverterParameter=0:gold}"
                                                            Foreground="{Binding DataContext.ButtonFocusIndex, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BtnFg}, ConverterParameter=0:gold}"
                                                            BorderBrush="{Binding DataContext.ButtonFocusIndex, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BtnBorder}, ConverterParameter=0:gold}" />
                                                    <Button Grid.Column="1" Content="Edit" Style="{StaticResource ActionButton}"
                                                            Click="OnRowEdit"
                                                            Background="{Binding DataContext.ButtonFocusIndex, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BtnBg}, ConverterParameter=1}"
                                                            Foreground="{Binding DataContext.ButtonFocusIndex, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BtnFg}, ConverterParameter=1}" />
                                                    <!-- Quiet trash button (right-aligned). Idle = danger-tinted glyph, no
                                                         fill; fills red on keyboard focus (ButtonFocusIndex==2) or hover. -->
                                                    <Button Grid.Column="3" Click="OnRowDelete" Cursor="Hand"
                                                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                                            Content="&#xE74D;"
                                                            Background="{Binding DataContext.ButtonFocusIndex, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BtnBg}, ConverterParameter=2:danger}"
                                                            Foreground="{Binding DataContext.ButtonFocusIndex, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BtnFg}, ConverterParameter=2:danger}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="tb" Background="{TemplateBinding Background}"
                                                                        CornerRadius="8" Padding="9,6">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="tb" Property="Background" Value="{StaticResource Danger}" />
                                                                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- ===== Inline edit mode (in-place, like macOS). The template is
                                             applied only when Content is non-null (i.e. this row is the one
                                             being edited), so 11 rows don't each build a heavy form. ===== -->
                                        <ContentControl Grid.Column="1" Focusable="False" Content="{Binding EditForm}">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource InlineEditTemplate}" />
                                                    <Style.Triggers>
                                                        <Trigger Property="Content" Value="{x:Null}">
                                                            <Setter Property="ContentTemplate" Value="{x:Null}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>

                                        <!-- Thin divider below unselected item rows (W-05).
                                             0.5 hairline to match mac; needs rounding opt-outs to render sub-pixel (PS-59). -->
                                        <Border Grid.Column="0" Grid.ColumnSpan="2" Height="0.5" Margin="8,11,8,-13"
                                                UseLayoutRounding="False" SnapsToDevicePixels="False"
                                                VerticalAlignment="Bottom" Background="{StaticResource Divider}"
                                                Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BoolVisInvert}}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                    </Grid>
                </DockPanel>

                <!-- Bottom resize handle (vertical drag) -->
                <Thumb Grid.Row="2" Height="16" Cursor="SizeNS"
                       DragDelta="OnResizeDrag" DragCompleted="OnResizeCompleted"
                       Visibility="{Binding CurrentView, Converter={StaticResource NotSettingsVis}, ConverterParameter=Settings}">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="Transparent">
                                <Border Width="32" Height="3" CornerRadius="1.5"
                                        Background="#26FFFFFF" HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>

                <!-- Settings panel (lives in the content row so the header /
                     back button stay visible, matching macOS) -->
                <Border Grid.Row="1" Background="{StaticResource Bg}"
                        Visibility="{Binding CurrentView, Converter={StaticResource SettingsVis}, ConverterParameter=Settings}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0">
                    <StackPanel Margin="16">

                        <!-- ===== Shortcut ===== -->
                        <TextBlock Text="SHORTCUT" Style="{StaticResource GroupHeader}" />
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Toggle Window" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Background="#14FFFFFF" CornerRadius="8" Padding="14,6"
                                        BorderBrush="{StaticResource NeutralBorder}" BorderThickness="1">
                                    <TextBlock Text="{Binding ShortcutDisplay}" FontSize="13" FontWeight="SemiBold"
                                               FontFamily="Consolas" Foreground="{StaticResource TextPrimary}" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- ===== General ===== -->
                        <TextBlock Text="GENERAL" Style="{StaticResource GroupHeader}" Margin="4,12,0,12" />

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Launch at Login" FontSize="15" FontWeight="Medium" Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Text="Automatically start PasteSheet when you log in." FontSize="12"
                                               Foreground="{StaticResource SubText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                          IsChecked="{Binding AutoStartEnabled, Mode=TwoWay}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Mouse Edge Detection" FontSize="15" FontWeight="Medium" Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Text="Slide into the screen when the mouse hits the right edge." FontSize="12"
                                               Foreground="{StaticResource SubText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                          IsChecked="{Binding MouseEdgeEnabled, Mode=TwoWay}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Auto-hide" FontSize="15" FontWeight="Medium" Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock Text="Automatically hide the window after a period of inactivity." FontSize="12"
                                                   Foreground="{StaticResource SubText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                              IsChecked="{Binding AutoHideEnabled, Mode=TwoWay}" />
                                </Grid>
                                <!-- Hide-after segmented selector -->
                                <Grid Margin="0,12,0,0"
                                      Visibility="{Binding AutoHideEnabled, Converter={StaticResource BoolVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Hide after" FontSize="14"
                                               Foreground="{StaticResource SubText}" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Background="#0FFFFFFF" CornerRadius="10" Padding="3">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="3s" Tag="3" Style="{StaticResource SegButton}" Click="OnTimeoutClick"
                                                    Background="{Binding AutoHideTimeout, Converter={StaticResource SegBg}, ConverterParameter=3}"
                                                    Foreground="{Binding AutoHideTimeout, Converter={StaticResource SegFg}, ConverterParameter=3}"
                                                    FontWeight="{Binding AutoHideTimeout, Converter={StaticResource SegWt}, ConverterParameter=3}" />
                                            <Button Content="5s" Tag="5" Style="{StaticResource SegButton}" Click="OnTimeoutClick"
                                                    Background="{Binding AutoHideTimeout, Converter={StaticResource SegBg}, ConverterParameter=5}"
                                                    Foreground="{Binding AutoHideTimeout, Converter={StaticResource SegFg}, ConverterParameter=5}"
                                                    FontWeight="{Binding AutoHideTimeout, Converter={StaticResource SegWt}, ConverterParameter=5}" />
                                            <Button Content="10s" Tag="10" Style="{StaticResource SegButton}" Click="OnTimeoutClick"
                                                    Background="{Binding AutoHideTimeout, Converter={StaticResource SegBg}, ConverterParameter=10}"
                                                    Foreground="{Binding AutoHideTimeout, Converter={StaticResource SegFg}, ConverterParameter=10}"
                                                    FontWeight="{Binding AutoHideTimeout, Converter={StaticResource SegWt}, ConverterParameter=10}" />
                                            <Button Content="30s" Tag="30" Style="{StaticResource SegButton}" Click="OnTimeoutClick"
                                                    Background="{Binding AutoHideTimeout, Converter={StaticResource SegBg}, ConverterParameter=30}"
                                                    Foreground="{Binding AutoHideTimeout, Converter={StaticResource SegFg}, ConverterParameter=30}"
                                                    FontWeight="{Binding AutoHideTimeout, Converter={StaticResource SegWt}, ConverterParameter=30}" />
                                            <Button Content="60s" Tag="60" Style="{StaticResource SegButton}" Click="OnTimeoutClick"
                                                    Background="{Binding AutoHideTimeout, Converter={StaticResource SegBg}, ConverterParameter=60}"
                                                    Foreground="{Binding AutoHideTimeout, Converter={StaticResource SegFg}, ConverterParameter=60}"
                                                    FontWeight="{Binding AutoHideTimeout, Converter={StaticResource SegWt}, ConverterParameter=60}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ===== Updates ===== -->
                        <TextBlock Text="UPDATES" Style="{StaticResource GroupHeader}" Margin="4,12,0,12" />
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Automatic Updates" FontSize="15" FontWeight="Medium" Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Text="Automatically check for updates in the background." FontSize="12"
                                               Foreground="{StaticResource SubText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                          IsChecked="{Binding AutoUpdateEnabled, Mode=TwoWay}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Check for Updates" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Check Now" Click="OnCheckUpdatesClick"
                                        Background="#14FFFFFF" Foreground="{StaticResource TextPrimary}" BorderThickness="0"
                                        FontSize="13" FontWeight="SemiBold" Padding="14,6" Cursor="Hand" />
                            </Grid>
                        </Border>

                        <!-- ===== Information ===== -->
                        <TextBlock Text="INFORMATION" Style="{StaticResource GroupHeader}" Margin="4,12,0,12" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Version" FontSize="14"
                                               Foreground="{StaticResource SubText}" />
                                    <TextBlock Grid.Column="1" Text="{Binding AppVersion}" FontSize="14" FontWeight="Medium"
                                               Foreground="{StaticResource TextPrimary}" />
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Developer" FontSize="14"
                                               Foreground="{StaticResource SubText}" />
                                    <TextBlock Grid.Column="1" Text="{Binding DeveloperName}" FontSize="14" FontWeight="Medium"
                                               Foreground="{StaticResource TextPrimary}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                </Border>
            </Grid>

            <!-- Detail overlay -->
            <Border Background="#8C000000" CornerRadius="12"
                    Visibility="{Binding HasDetail, Converter={StaticResource BoolVis}}"
                    MouseDown="OnDetailBackdrop">
                <!-- macOS parity: modal is 90% of panel width x 80% of panel height, centered -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.05*" />
                        <ColumnDefinition Width="0.9*" />
                        <ColumnDefinition Width="0.05*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="0.1*" />
                        <RowDefinition Height="0.8*" />
                        <RowDefinition Height="0.1*" />
                    </Grid.RowDefinitions>
                <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource Surface}" CornerRadius="12"
                        BorderBrush="{StaticResource NeutralBorder}" BorderThickness="1" ClipToBounds="True"
                        Style="{StaticResource ModalCardAnim}" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                    </Border.RenderTransform>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- Header -->
                        <Border Grid.Row="0" Background="{StaticResource Surface}" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Detail" FontSize="15" FontWeight="Medium"
                                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Click="OnDetailCopy" Margin="0,0,8,0"
                                        Background="{StaticResource Accent}" Foreground="{StaticResource PanelBg}" FontWeight="SemiBold"
                                        BorderThickness="0" Padding="12,6" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <TextBlock Text="Copy" FontSize="11" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Content="&#xE711;" Click="OnDetailClose"
                                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                        Style="{StaticResource IconButton}" Foreground="{StaticResource TextSecondary}" />
                            </Grid>
                        </Border>
                        <!-- Body -->
                        <ScrollViewer Grid.Row="1" Background="{StaticResource PanelBg}" VerticalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding DetailItem.Content, Mode=OneWay}" IsReadOnly="True"
                                     Background="Transparent" BorderThickness="0" Foreground="#FFCFCFC8"
                                     FontFamily="Consolas" FontSize="14" Padding="24"
                                     TextWrapping="Wrap" IsTabStop="False" />
                        </ScrollViewer>
                        <!-- Meta footer: date · N chars -->
                        <StackPanel Grid.Row="2" Background="{StaticResource Surface}">
                            <Border Height="1" Background="{StaticResource Divider}" />
                            <TextBlock Text="{Binding DetailMeta}" FontSize="11"
                                       Foreground="{StaticResource TextTertiary}" Margin="16,10" />
                        </StackPanel>
                    </Grid>
                </Border>
                </Grid>
            </Border>

            <!-- Modal overlay -->
            <Border Background="#8C000000" CornerRadius="12"
                    Visibility="{Binding HasModal, Converter={StaticResource BoolVis}}"
                    MouseDown="OnModalBackdrop">
                <Border Background="{StaticResource PanelBg}" CornerRadius="12" Padding="20" MaxWidth="320"
                        Margin="20" VerticalAlignment="Center" HorizontalAlignment="Center"
                        BorderBrush="{StaticResource NeutralBorder}" BorderThickness="1"
                        Style="{StaticResource ModalCardAnim}" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.45" BlurRadius="24" ShadowDepth="12" Direction="270" />
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{StaticResource DangerText}" VerticalAlignment="Center" Margin="0,0,6,0"
                                       Visibility="{Binding Modal.IsDanger, Converter={StaticResource BoolVis}}" />
                            <TextBlock Text="{Binding Modal.Title}" Foreground="{StaticResource TextPrimary}"
                                       FontWeight="SemiBold" FontSize="17" />
                        </StackPanel>
                        <TextBlock Text="{Binding Modal.Message}" Foreground="{StaticResource TextSecondary}"
                                   FontSize="13" TextWrapping="Wrap" LineHeight="18" Margin="0,12,0,0" />
                        <!-- Delete target preview block -->
                        <Border CornerRadius="8" Padding="12,10" Margin="0,12,0,0"
                                Background="{StaticResource Surface}" BorderBrush="{StaticResource Divider}" BorderThickness="1"
                                Visibility="{Binding Modal.HasPreview, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding Modal.PreviewText}" Foreground="{StaticResource TextSecondary}"
                                       FontFamily="Consolas" FontSize="13" TextTrimming="CharacterEllipsis"
                                       TextWrapping="Wrap" MaxHeight="36" />
                        </Border>
                        <Border x:Name="ModalInputBorder" Background="{StaticResource Surface}" CornerRadius="8" Padding="8"
                                Margin="0,12,0,0" BorderBrush="{StaticResource NeutralBorder}" BorderThickness="1"
                                Visibility="{Binding Modal.ShowInput, Converter={StaticResource BoolVis}}">
                            <TextBox x:Name="ModalInput" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource TextPrimary}" CaretBrush="{StaticResource Accent}" FontSize="14"
                                     Text="{Binding Modal.InputValue, UpdateSourceTrigger=PropertyChanged}" />
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button Content="{Binding Modal.CancelText}" Padding="16,8" Margin="0,0,8,0" Click="OnModalCancel"
                                    Background="{StaticResource Surface}" Foreground="{StaticResource TextPrimary}"
                                    BorderBrush="{StaticResource NeutralBorder}" BorderThickness="1"
                                    FontSize="14" Cursor="Hand" />
                            <Button x:Name="ModalConfirm" Content="{Binding Modal.ConfirmButtonText}" Padding="16,8"
                                    Click="OnModalConfirm" FontSize="14" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                                    Background="{Binding Modal.IsDanger, Converter={StaticResource ConfirmBg}}"
                                    Foreground="{Binding Modal.IsDanger, Converter={StaticResource ConfirmFg}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
